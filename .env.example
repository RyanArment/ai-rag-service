# Local demo (SQLite + Chroma + free local embeddings)
DEBUG=true
RATE_LIMIT_ENABLED=false

# --- LLM (pick one block) ---

# Option A: xAI Grok — https://console.x.ai
LLM_PROVIDER=xai
EMBEDDING_PROVIDER=local
VECTOR_STORE_PROVIDER=chroma
XAI_API_KEY=your_xai_api_key
XAI_MODEL=grok-4.7
# XAI_BASE_URL=https://api.x.ai/v1

# Option B: Groq (free tier) — https://console.groq.com
# LLM_PROVIDER=openai
# EMBEDDING_PROVIDER=local
# VECTOR_STORE_PROVIDER=chroma
# OPENAI_API_KEY=your_groq_api_key
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# Option B: OpenRouter free models — https://openrouter.ai
# LLM_PROVIDER=openai
# EMBEDDING_PROVIDER=local
# VECTOR_STORE_PROVIDER=chroma
# OPENAI_API_KEY=your_openrouter_api_key
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Option C: Google Gemini (free tier in AI Studio) — requires a Gemini client (not wired yet)
# Use Groq or OpenRouter for now with the OpenAI-compatible settings above.

# Option D: Paid OpenAI / Anthropic
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# EMBEDDING_PROVIDER=local
# VECTOR_STORE_PROVIDER=chroma

# SEC EDGAR (required by SEC; use your email)
SEC_USER_AGENT=ai-rag-service (contact: you@example.com)
